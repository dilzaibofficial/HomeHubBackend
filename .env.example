ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
STRIPE_SECRET_KEY=
BREVO_API_KEY=
OPENAI_API_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=
ADMIN_STREAM_USER_ID=

# Required on Render (and any non-local environment). Leave unset locally
# to fall back to a local MongoDB instance - see database/connect.js.
MONGO_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/homeHub?appName=homeHub

# Render sets this automatically - do not set it manually there.
PORT=2000
