ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
STRIPE_SECRET_KEY=
BREVO_API_KEY=
OPENAI_API_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=
ADMIN_STREAM_USER_ID=

# Required on Render (and any non-local environment). Leave unset locally
# to fall back to a local MongoDB instance - see database/connect.js.
MONGO_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/homeHub?appName=homeHub

# Render sets this automatically - do not set it manually there.
PORT=2000

# --- Property photo verification ---
# Base URL of the separate verification-service (Python/FastAPI) deployment.
ML_VERIFICATION_SERVICE_URL=
# Must match SERVICE_SHARED_SECRET in that service's own env.
ML_VERIFICATION_SERVICE_SECRET=
# Kill switch - set to "false" to disable the feature without a redeploy.
VERIFICATION_ENABLED=true
# Aggregate match score (0-1) at/above which a property is auto-verified.
VERIFICATION_AUTO_VERIFY_THRESHOLD=0.80
# Aggregate match score (0-1) at/below which a property is auto-rejected
# (never reaches the admin queue). Between the two thresholds = pending admin review.
VERIFICATION_AUTO_REJECT_THRESHOLD=0.35
# How long to wait for the verification service before treating it as down.
ML_SERVICE_TIMEOUT_MS=45000
